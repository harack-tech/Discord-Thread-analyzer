# Discord Developer Portal で発行したボットトークン
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# 使用するLLMプロバイダー: "gemini"(既定) または "openai"
LLM_PROVIDER=gemini

# --- Google Gemini を使う場合 ---
# APIキーは https://aistudio.google.com/app/apikey で取得
GEMINI_API_KEY=your_gemini_api_key_here
# "gemini-flash-latest"(標準Flash) または
# "gemini-flash-lite-latest"(より低コスト・低レイテンシのFlash-Lite) を指定可能
GEMINI_MODEL=gemini-flash-latest
# 1回の応答の最大出力トークン数(任意)
GEMINI_MAX_OUTPUT_TOKENS=4096

# --- OpenAI(ChatGPT)を使う場合 ---
# LLM_PROVIDER=openai のときのみ必要
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=4096

# スラッシュコマンドを即時反映させたい開発用サーバーのID(任意)
# 未指定の場合はグローバル同期(反映まで最大1時間程度かかることがあります)
DISCORD_GUILD_ID=

# /analyze の limit 未指定時のデフォルト値(任意)
DEFAULT_HISTORY_LIMIT=300
